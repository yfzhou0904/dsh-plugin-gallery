{
  "name": "@yfzhou/dsh-touch-tooltips",
  "description": "Suppresses DSH's hover/focus tooltip bubbles on touch devices, where a tap leaves them stuck on screen.",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "files": ["lib", "README.md", "LICENSE", "cordis.bundle.yml"],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.bundle.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yfzhou0904/dsh-plugin-gallery.git",
    "directory": "plugins/touch-tooltips"
  },
  "homepage": "https://github.com/yfzhou0904/dsh-plugin-gallery#readme",
  "bugs": {
    "url": "https://github.com/yfzhou0904/dsh-plugin-gallery/issues"
  },
  "keywords": ["deepseek", "dsh", "cordis", "plugin", "tooltip", "touch", "mobile"],
  "publishConfig": { "access": "public" },
  "license": "MIT"
}
