{
  "name": "@yfzhou/dsh-mobile-sidebar",
  "description": "Hides the collapsed sidebar rail on mobile and adds DSH's native sidebar toggle to the shell.",
  "version": "0.1.2",
  "type": "module",
  "main": "lib/index.js",
  "files": ["lib", "README.md", "LICENSE", "cordis.bundle.yml"],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.bundle.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["layout", "slots"]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yfzhou0904/dsh-plugin-gallery.git",
    "directory": "plugins/mobile-sidebar"
  },
  "homepage": "https://github.com/yfzhou0904/dsh-plugin-gallery#readme",
  "bugs": "https://github.com/yfzhou0904/dsh-plugin-gallery/issues",
  "keywords": ["deepseek", "dsh", "cordis", "plugin", "mobile", "sidebar"],
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.6"
  },
  "publishConfig": { "access": "public" },
  "license": "MIT"
}
