{
  "name": "@yfzhou/dsh-llm-codex-subscription",
  "version": "0.1.3",
  "description": "DSH LLM 适配器插件:复用 Codex CLI 本地登录凭证(~/.codex/auth.json)在 DSH 中直接使用 ChatGPT 订阅模型",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./transport": "./lib/transport.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE",
    "cordis.bundle.yml"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/serialize.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "llm",
    "adapter",
    "codex",
    "chatgpt"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yfzhou0904/dsh-plugin-gallery.git",
    "directory": "plugins/codex-subscription"
  },
  "homepage": "https://github.com/yfzhou0904/dsh-plugin-gallery#readme",
  "bugs": "https://github.com/yfzhou0904/dsh-plugin-gallery/issues",
  "keywords": ["deepseek", "dsh", "cordis", "llm", "adapter", "codex", "chatgpt"],
  "publishConfig": { "access": "public" },
  "dsh": {
    "bundle": {
      "patch": "./cordis.bundle.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.6",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "eventsource-parser": "^3.1.1",
    "https-proxy-agent": "^7.0.6",
    "node-fetch": "^3.3.2"
  }
}
